<Window x:Class="NetSpeedMeter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NetSpeedMeter.ViewModels"
        xmlns:models="clr-namespace:NetSpeedMeter.Models"
        mc:Ignorable="d"
        Title="NetSpeed Meter Settings"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1219"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI, Segoe UI Variable Text"
        Icon="../Assets/app.ico"
        d:DataContext="{d:DesignInstance viewModels:SettingsViewModel}">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#181D28" />
        <SolidColorBrush x:Key="CardBorder" Color="#283245" />
        <SolidColorBrush x:Key="SubTextColor" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentColor" Color="#00A3FF" />
        <SolidColorBrush x:Key="ButtonHover" Color="#252F42" />

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F9" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Settings Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                <!-- Section: General -->
                <TextBlock Text="GENERAL"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource SubTextColor}"
                           Margin="2,0,0,6" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <CheckBox Content="Launch at Windows startup"
                                  IsChecked="{Binding LaunchAtStartup}" />
                        <CheckBox Content="Start monitoring automatically on launch"
                                  IsChecked="{Binding AutoStartMonitoring}" />
                        <CheckBox Content="Show floating taskbar meter automatically"
                                  IsChecked="{Binding AutoShowFloatingMeter}" />
                        <CheckBox Content="Minimize to system tray when main window is closed"
                                  IsChecked="{Binding MinimizeToTrayOnClose}" />

                        <!-- Speed Display Mode Selection -->
                        <Border Margin="0,8,0,2" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="225" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Speed Display Mode:" FontSize="13" Foreground="#E2E8F0" />
                                    <TextBlock Text="Choose which values to display" FontSize="11" Foreground="{StaticResource SubTextColor}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Height="30"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedDisplayMode}"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="Both Download &amp; Upload" Tag="{x:Static models:SpeedDisplayMode.Both}" />
                                    <ComboBoxItem Content="Only Download Speed" Tag="{x:Static models:SpeedDisplayMode.DownloadOnly}" />
                                    <ComboBoxItem Content="Only Upload Speed" Tag="{x:Static models:SpeedDisplayMode.UploadOnly}" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section: Network Adapter -->
                <TextBlock Text="NETWORK ADAPTER"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource SubTextColor}"
                           Margin="2,4,0,6" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Select Network Interface:"
                                   FontSize="13"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableAdapters}"
                                  SelectedItem="{Binding SelectedAdapter}"
                                  DisplayMemberPath="DisplayName"
                                  Height="32"
                                  Background="#242B3B"
                                  Foreground="#0F172A" />
                        <TextBlock Text="Automatic mode will select the active adapter with the highest throughput and valid gateway."
                                   FontSize="11"
                                   Foreground="{StaticResource SubTextColor}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Section: Traffic & Units -->
                <TextBlock Text="TRAFFIC &amp; UNITS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource SubTextColor}"
                           Margin="2,4,0,6" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Refresh Interval:" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="140"
                                        Minimum="0.5"
                                        Maximum="5.0"
                                        SmallChange="0.5"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding RefreshIntervalSeconds}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RefreshIntervalSeconds, StringFormat='{}{0:F1}s'}"
                                           Width="40"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource SubTextColor}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Speed Units Mode:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      Height="30"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedSpeedUnit}">
                                <ComboBoxItem Content="Auto Binary (1024 B/KB/MB)" Tag="{x:Static models:SpeedUnitMode.AutoBinary}" />
                                <ComboBoxItem Content="Auto Decimal (1000 B/KB/MB)" Tag="{x:Static models:SpeedUnitMode.AutoDecimal}" />
                                <ComboBoxItem Content="Always KB/s" Tag="{x:Static models:SpeedUnitMode.ForceKB}" />
                                <ComboBoxItem Content="Always MB/s" Tag="{x:Static models:SpeedUnitMode.ForceMB}" />
                                <ComboBoxItem Content="Always GB/s" Tag="{x:Static models:SpeedUnitMode.ForceGB}" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Floating Meter Appearance & Position -->
                <TextBlock Text="FLOATING METER"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource SubTextColor}"
                           Margin="2,4,0,6" />
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Theme -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      Height="30"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedTheme}">
                                <ComboBoxItem Content="Dark Mode (Default)" Tag="{x:Static models:AppTheme.Dark}" />
                                <ComboBoxItem Content="Light Mode" Tag="{x:Static models:AppTheme.Light}" />
                            </ComboBox>
                        </Grid>

                        <!-- Opacity -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Meter Opacity:" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="140"
                                        Minimum="0.2"
                                        Maximum="1.0"
                                        SmallChange="0.05"
                                        Value="{Binding MeterOpacity}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MeterOpacity, StringFormat='{}{0:P0}'}"
                                           Width="40"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource SubTextColor}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Speed Value Font Size -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Speed Text Size:" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="140"
                                        Minimum="10"
                                        Maximum="24"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding MeterFontSize}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MeterFontSize, StringFormat='{}{0:F0} px'}"
                                           Width="40"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource SubTextColor}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Restore Defaults Button -->
                <Button Content="Restore Default Settings"
                        Command="{Binding RestoreDefaultsCommand}"
                        Height="32"
                        Background="Transparent"
                        Foreground="#EF4444"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,4,0,10" />

            </StackPanel>
        </ScrollViewer>

        <!-- Action Footer -->
        <Border Grid.Row="2"
                Padding="0,16,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="90"
                        Height="34"
                        Background="#202636"
                        Foreground="#E2E8F0"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        Margin="0,0,10,0"
                        Cursor="Hand" />

                <Button Grid.Column="2"
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="90"
                        Height="34"
                        Background="#00A3FF"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</Window>
