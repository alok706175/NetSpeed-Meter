<Window x:Class="NetSpeedMeter.Views.SpeedMeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NetSpeedMeter.ViewModels"
        mc:Ignorable="d"
        Title="NetSpeed Meter - Floating"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        Opacity="{Binding Opacity, FallbackValue=0.92}"
        d:DataContext="{d:DesignInstance viewModels:SpeedMeterViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Accent Colors -->
        <SolidColorBrush x:Key="DownloadColorBrush" Color="#00D1FF" />
        <SolidColorBrush x:Key="UploadColorBrush" Color="#FF9900" />

        <!-- Text Colors -->
        <SolidColorBrush x:Key="DarkTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LightTextBrush" Color="#0F172A" />

        <!-- Style for Speed Text Foreground (Dark/Light mode) -->
        <Style x:Key="SpeedTextForegroundStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource LightTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="MeterContextMenu">
            <MenuItem Header="Open NetSpeed Meter"
                      FontWeight="SemiBold"
                      Command="{Binding OpenMainWindowCommand}" />
            <Separator />
            <MenuItem Header="{Binding MonitoringToggleText}"
                      Command="{Binding ToggleMonitoringCommand}" />
            <MenuItem Header="Settings..."
                      Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <MenuItem Header="Exit"
                      Command="{Binding ExitCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
          PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
          ContextMenu="{StaticResource MeterContextMenu}"
          Cursor="Hand"
          Background="#01000000"
          Margin="0">

        <!-- Outer Container Border (Frameless Taskbar Clock Look) -->
        <Border x:Name="MeterContainerBorder"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="4"
                Padding="6,2,6,2">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- Hover Highlight Dark Theme -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsDarkTheme}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#1FFFFFFF" />
                        </MultiDataTrigger>

                        <!-- Hover Highlight Light Theme -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsDarkTheme}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#15000000" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!-- 1-Line Horizontal Layout -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Download Speed -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="↓"
                               Foreground="{StaticResource DownloadColorBrush}"
                               FontFamily="Segoe UI, Segoe UI Variable Display"
                               FontWeight="Bold"
                               FontSize="{Binding ArrowFontSize}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <TextBlock Text="{Binding DownloadSpeedText, FallbackValue='0 B/s'}"
                               FontFamily="Segoe UI Semibold, Segoe UI Variable Text, Consolas"
                               FontSize="{Binding FontSize}"
                               VerticalAlignment="Center"
                               Style="{StaticResource SpeedTextForegroundStyle}" />
                </StackPanel>

                <!-- Upload Speed -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowUpload, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="↑"
                               Foreground="{StaticResource UploadColorBrush}"
                               FontFamily="Segoe UI, Segoe UI Variable Display"
                               FontWeight="Bold"
                               FontSize="{Binding ArrowFontSize}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <TextBlock Text="{Binding UploadSpeedText, FallbackValue='0 B/s'}"
                               FontFamily="Segoe UI Semibold, Segoe UI Variable Text, Consolas"
                               FontSize="{Binding FontSize}"
                               VerticalAlignment="Center"
                               Style="{StaticResource SpeedTextForegroundStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
